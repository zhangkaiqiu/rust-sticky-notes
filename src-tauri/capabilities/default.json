{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "便签窗口的默认能力集（每张便签的 label 都是 note-<id>）",
  "windows": ["note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
